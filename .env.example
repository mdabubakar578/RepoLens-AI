# Google Gemini API Key
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
AI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=2

# GitHub API Token (optional, for repository URL analysis)
GITHUB_API_TOKEN=YOUR_GITHUB_API_TOKEN_HERE
GIT_CLONE_TIMEOUT_SECONDS=45
INDEX_FETCH_WORKERS=8
ANALYSIS_WORKERS=4
ANALYSIS_QUEUE_SIZE=12
RAG_USE_EMBEDDINGS=false

# Flask Secret Key (generate a long random value for non-local deployments)
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Flask Debug Mode
FLASK_DEBUG=false
